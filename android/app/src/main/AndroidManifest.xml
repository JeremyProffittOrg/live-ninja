<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Share the phone's location with the assistant at session start
         (location/LocationReporter: POST /api/v1/location/current). Asked by
         StartupPermissionGate; denied simply means nothing is reported.
         Foreground-only: no ACCESS_BACKGROUND_LOCATION. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Load-bearing for M21.2's echo fix, and silent when absent: all three
         transports' configureAudioForCall() set AudioManager.mode =
         MODE_IN_COMMUNICATION (WebRtcTransport.kt:494, NovaBridgeTransport.kt:477,
         GeminiLiveTransport.kt:696) so AEC3 gets a render reference on the
         communication path, and setMode()/setCommunicationDevice() without this
         permission are dropped by AudioService with no exception and no log — the
         failure mode is silently keeping MODE_NORMAL, which is what lets the
         assistant transcribe its own loudspeaker output as user speech.
         Normal install-time permission — no runtime grant needed, so adding it
         costs nothing. CONFIRMED on the Tab S9 FE 2026-07-25: without this line the
         readback was "call audio: mode=0" (MODE_NORMAL) despite setMode() being
         called; with it, "call audio: mode=3 route=2" and WebRTC's own VolumeLogger
         agrees ("audio mode is: MODE_IN_COMMUNICATION"). Still outstanding under
         M23.2: a spoken round-trip proving the echo is actually gone, which needs
         a real voice and audible playback. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Opt-in phone-based car audio (realtime/CarAudioSession.kt): use an
         ALREADY connected car/headset's hands-free (HFP/SCO, BLE headset) for
         the call audio. Runtime BLUETOOTH_CONNECT on API 31+ (requested by the
         car-audio settings UI); legacy BLUETOOTH for SCO on API <= 30. No
         BLUETOOTH_SCAN / ADMIN: the app never scans or pairs. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Session FGS expands to microphone|mediaPlayback while a realtime call is live. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Wake the screen over the keyguard on wake-word detection (01-platform §B-ii). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Session-scoped PARTIAL_WAKE_LOCK so Doze cannot stall a screen-off session. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Battery-optimization exemption prompt (onboarding + Settings health card). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Live-session floating bubble (TYPE_APPLICATION_OVERLAY). Optional —
         requested via Settings.ACTION_MANAGE_OVERLAY_PERMISSION in onboarding;
         LiveOverlayController no-ops without the user grant. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Sideload updates from the published APK on live.jeremy.ninja
         (update/AppUpdateCoordinator: on app start + AppUpdateWorker every 6 h). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Camera tools are optional capability: camera-less tablets may still
         install and use every non-camera feature; the tools report unavailable. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Package visibility (API 30+): AssistantRoleController resolve-checks the
         OEM assistant-settings deep-link candidates before launching them. -->
    <queries>
        <intent>
            <action android:name="android.settings.VOICE_INPUT_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_DEFAULT_APPS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <package android:name="com.android.settings" />

        <!-- play_media (realtime/DeviceMediaTools.kt): resolve-before-start for
             exactly the two fixed media apps, plus an HTTPS browser resolver for
             the honest web-search fallback. No QUERY_ALL_PACKAGES. -->
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.google.android.youtube" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".LiveNinjaApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiveNinja">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- LWA broker return: the server-side /auth/lwa/callback redirects
                 to this verified App Link after it has exchanged the LWA code.
                 The exact path prevents the app from claiming unrelated site
                 navigation. assetlinks.json binds this origin to the release
                 signing certificate; LWA still sees only the server callback. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="live.jeremy.ninja"
                    android:path="/auth/lwa/app-return" />
            </intent-filter>

            <!-- Compatibility fallback for debug builds or devices whose App
                 Links verification has not completed. The HTTPS return handler
                 redirects here if Android did not intercept the verified URL. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="ninja.jeremy.liveninja"
                    android:host="lwa" />
            </intent-filter>
        </activity>

        <!-- Assistant role anchor (ROLE_ASSISTANT). Bound by the system while
             Live Ninja is the default digital assistant; metadata wires the
             session + recognition services (Android §2). -->
        <service
            android:name=".assistant.LiveNinjaVoiceInteractionService"
            android:exported="true"
            android:label="@string/assistant_service_label"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
        </service>

        <!-- Creates LiveNinjaSession instances for assist gestures / keyguard
             voice assist; referenced from xml/interaction_service.xml. -->
        <service
            android:name=".assistant.LiveNinjaSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Required companion of a voice-interaction service. Declines
             external recognition requests (realtime-session-only recognizer). -->
        <service
            android:name=".assistant.LiveNinjaRecognitionService"
            android:exported="true"
            android:label="@string/recognition_service_label">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- Always-listening wake-word FGS (plan.md M4, Android §3.2). -->
        <service
            android:name=".wake.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <!-- Voice-command photo/video capture. Short-lived and camera-typed so
             Android keeps the privacy indicator + visible notification active
             from Camera2 open through the server-verified S3 upload. -->
        <service
            android:name=".realtime.CameraCaptureService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- Opt-in phone car audio (realtime/CarAudioForegroundService.kt).
             Short-lived session service started only from an explicit start in
             the visible app, for one car-audio conversation, with an ongoing
             notification and End. Not sticky; never started at boot or on a
             Bluetooth connection. stopWithTask=false so onTaskRemoved can end
             the session deliberately. -->
        <service
            android:name=".realtime.CarAudioForegroundService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <!-- Log export share flow (04-logging §A7): grants read access to the
             zipped log bundle in filesDir/logs/ via a content:// URI. Paths in
             res/xml/file_paths.xml (authority ninja.jeremy.liveninja.fileprovider,
             matching LogExporter.FILE_PROVIDER_AUTHORITY). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="ninja.jeremy.liveninja.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Restart the wake service after reboot / app update when enabled. Only the system
             can send these protected broadcasts, so exported is safe and required for
             delivery on all OEMs. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ninja.jeremy.liveninja.UPDATE_INSTALL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".wake.WakeBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- M22.2 cold start: LiveNinjaApplication implements Configuration.Provider, but
             that alone does NOT make WorkManager's init lazy: the androidx.startup
             ContentProvider below still eagerly calls WorkManager.initialize() (opening its
             Room work database) during ContentProvider.onCreate(), which runs before
             Application.onCreate() on every process start, whether or not the wake service is
             even enabled. This tools:node="remove" merge is the other required half of
             WorkManager's documented "on-demand initialization" recipe: with the default
             initializer's meta-data gone, WorkManager only initializes (using
             workManagerConfiguration above) the first time WorkManager.getInstance(context) is
             actually called: WakeWatchdogWorker.enqueue()/cancel() from WakeWordService, and
             AppUpdateWorker.enqueue() from MainActivity.onStart, which runs it off the main
             thread so the work database never opens on the launch path. This is also the fix for the pre-existing
             RemoveWorkManagerInitializer lint error (plan.md M22 baseline). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
